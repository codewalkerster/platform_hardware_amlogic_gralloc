// *** THIS PACKAGE HAS SPECIAL LICENSING CONDITIONS.  PLEASE
//     CONSULT THE OWNERS AND opensource-licensing@google.com BEFORE
//     DEPENDING ON IT IN YOUR PROJECT. ***
package {
    default_applicable_licenses: ["hardware_amlogic_gralloc_amlogic_license"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "hardware_amlogic_gralloc_amlogic_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "legacy_by_exception_only", // by exception only
        "legacy_proprietary", // by exception only
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_library_shared {
    name: "libamgralloc_ext",
	defaults: [
    "gralloc_go_defaults",
    ],		
    vendor_available: true,
    system_ext_specific: true,
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libion",
        "libhardware",
        "android.hardware.graphics.common@1.0",
        "android.hardware.graphics.mapper@4.0",
        "libgralloctypes",
        "libhidlbase",
    ],
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
        "-DLOG_TAG=\"gralloc\""
    ],
    include_dirs: [
        "hardware/amlogic/gralloc/src",
    ],
    srcs: ["am_gralloc_ext.cpp"],
    export_include_dirs: ["."],
}

cc_library_static {
    name: "libamgralloc_ext_static",
	defaults: [
	"gralloc_go_defaults",
	],
    proprietary: true,
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libhardware",
        "android.hardware.graphics.common@1.0",
        "android.hardware.graphics.mapper@4.0",
        "libgralloctypes",
        "libhidlbase",
    ],
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
    ],
    include_dirs: [
        "hardware/amlogic/gralloc/src",
    ],
    srcs: ["am_gralloc_ext.cpp"],
}

// Internal static lib for amlogic extend gralloc
cc_library_static {
    name: "libamgralloc_internal_static",
    proprietary: true,
    vendor: true,
    host_supported: true,
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
    ],
    srcs: [
        "am_gralloc_internal.cpp"
    ],
    include_dirs: [
        "hardware/amlogic/gralloc/src",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",

    ],
    header_libs: [
        "libsystem_headers",
        "libhardware_headers",
    ],
}
