package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_defaults {
    name: "android_hardware_graphics_common_defaults",
    shared_libs: [
        "android.hardware.graphics.common-V4-ndk",
    ],
}

cc_defaults {
    name: "arm_gralloc_platform_flags",
    cflags: [
        "-DPLATFORM_API_LEVEL=34"
    ],
}

cc_defaults {
    name: "arm_gralloc_uses_aidl_defaults",
    defaults: [
        "android_hardware_graphics_common_defaults",
    ],
    shared_libs: [
        "arm.graphics-V5-ndk",
    ],
    export_shared_lib_headers: ["arm.graphics-V5-ndk"],
}

cc_defaults {
    name: "arm_gralloc_capabilities_version_specifics",
    header_libs: [
        "libxsdc-utils",
    ],
}

cc_defaults {
    name: "arm_gralloc_xml_configuration_version_specifics",
    header_libs: [
        "libxsdc-utils",
    ],
    export_header_lib_headers: [
        "libxsdc-utils",
    ],
}

cc_defaults {
    name: "gralloc_allocator_platform_dependencies",
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
    ],
}
