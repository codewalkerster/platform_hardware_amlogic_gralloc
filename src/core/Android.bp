package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_defaults {
	name: "arm_gralloc_core_defaults",
	defaults: [
		"arm_gralloc_defaults",
		"arm_gralloc_version_defaults",
	],

	srcs: [
		"buffer_access.cpp",
		"buffer_allocation.cpp",
		"formats.cpp",
		"reference.cpp",
		"format_info.cpp",
		"drm_utils.cpp",
	],
	include_dirs: [
		"hardware/amlogic/gralloc/amlogic",
	],
	static_libs: [
		"libarect",
		"libamgralloc_internal_static",
	],
	shared_libs: [
		"liblog",
		"libcutils",
		"libutils",
		"libdrm",
	],
	target: {
		android: {
			shared_libs: [
				"libhardware",
			],
		},
	},
	cflags: [
		"-DGRALLOC_AML_EXTEND=1",
	]
}

cc_library_static {
	name: "libgralloc_core",
	defaults: [
		"arm_gralloc_core_defaults",
		"arm_gralloc_version_defaults",
	],
}

cc_library_host_static {
	name: "libgralloc_core_host",
	defaults: [
		"arm_gralloc_core_defaults",
	],
}
