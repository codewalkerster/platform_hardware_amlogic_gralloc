package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

filegroup {
    name: "arm_gralloc_core_defaults_srcs",
    srcs: [
        "buffer_access.cpp",
        "buffer_allocation.cpp",
        "formats.cpp",
        "format_info.cpp",
        "drm_utils.cpp",
        "am_gralloc_internal.cpp",
    ],
}

cc_defaults {
    name: "arm_gralloc_core_defaults",
    defaults: [
        "arm_gralloc_defaults",
    ],

    srcs: [
        ":arm_gralloc_core_defaults_srcs",
    ],
    include_dirs: [
        "hardware/amlogic/gralloc/amlogic",
    ],
    static_libs: [
        "libarect",
    ],
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libdrm",
    ],
    target: {
        android: {
            shared_libs: [
                "libhardware",
            ],
        },
    },
    // Usage of these build configuration variables should be replaced by descriptor flags
    product_variables: {
        platform_sdk_version: {
            cflags: ["-DPLATFORM_SDK_VERSION=%d"],
        },
    },
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
    ]
}

cc_library_static {
    name: "libgralloc_core",
    defaults: [
        "arm_gralloc_core_defaults",
        "arm_gralloc_version_defaults",
    ],
}

filegroup {
    name: "arm_gralloc_internal_format_defaults_srcs",
    srcs: [
        "internal_format.cpp",
    ],
}

cc_defaults {
    name: "arm_gralloc_internal_format_defaults",
    owner: "arm",
    vendor: true,
    proprietary: true,
    defaults: [
        "arm_gralloc_defaults",
        "arm_gralloc_version_defaults",
    ],
    srcs: [
        ":arm_gralloc_internal_format_defaults_srcs",
    ],
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
    ]
}

cc_library_static {
    name: "libgralloc_internal_format",
    host_supported: true,
    defaults: [
        "arm_gralloc_internal_format_defaults",
    ],
}
