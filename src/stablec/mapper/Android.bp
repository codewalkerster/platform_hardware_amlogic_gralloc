package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_defaults {
    name: "arm_gralloc_stablec_defaults",
    defaults: [
        "arm_gralloc_defaults",
        "arm_gralloc_version_defaults",
        "arm_gralloc_uses_aidl_defaults",
        "libgralloc_allocator_dependencies",
    ],
    compile_multilib: "both",
    relative_install_path: "hw/",
    shared_libs: [
        "libhardware",
        "liblog",
        "libcutils",
        "libsync",
        "libutils",
        "libnativewindow",
        "libgralloctypes",
    ],
    static_libs: [
        "libarect",
        "libgralloc_core",
        "libgralloc_allocator",
        "libgralloc_internal_format",
    ],
}

cc_library_shared {
    name: "mapper.arm",
    defaults: [
        "arm_gralloc_defaults",
        "libgralloc_mapper_deps",
        "arm_gralloc_stablec_defaults",
    ],
    vintf_fragments: ["mapper.arm.xml"],
    static_libs: [
        "libgralloc_mapper_common",
        "libamgralloc_internal_static",
    ],
    header_libs: [
        "libbase_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
    ],
    srcs: [
        "mapper.cpp",
    ],
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
    ],
}

cc_defaults {
    name: "arm_gralloc_mapper_version_defaults",
    cflags: [
        "-DGRALLOC_STABLEC_MAPPER_ENABLED=1",
    ],
}
