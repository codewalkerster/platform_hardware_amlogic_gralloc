package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

soong_config_module_type {
    name: "arm_gralloc_allocator_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "arm_gralloc",
    variables: [
        "gralloc_use_ion_dma_heap",
        "gralloc_use_contiguous_display_memory",
        "build_kernel_4_9",
        "use_ion_flag",
        "use_dma_flag",
    ],
    properties: [
        "cflags",
        "srcs",
        "include_dirs",
    ],
}

soong_config_bool_variable {
    name: "gralloc_use_ion_dma_heap",
}
soong_config_bool_variable {
    name: "gralloc_use_contiguous_display_memory",
}

soong_config_bool_variable {
    name: "build_kernel_4_9",
}

soong_config_bool_variable {
    name: "use_ion_flag",
}

soong_config_bool_variable {
    name: "use_dma_flag",
}

arm_gralloc_allocator_cc_defaults {
    name: "arm_gralloc_allocator_defaults",
    defaults: [
        "arm_gralloc_defaults",
    ],
    soong_config_variables: {
        gralloc_use_ion_dma_heap: {
            cflags: [
                "-DGRALLOC_USE_ION_DMA_HEAP=1",
            ],
        },
        gralloc_use_contiguous_display_memory: {
            cflags: [
                "-DGRALLOC_USE_CONTIGUOUS_DISPLAY_MEMORY=1",
            ],
        },
        build_kernel_4_9: {
            cflags: [
                "-DBUILD_KERNEL_4_9=1",
            ],
            include_dirs: [
                "system/memory/libion/include",
            ],
        },
        use_ion_flag: {
            srcs: ["ion/ion.cpp"],
        },
        use_dma_flag: {
            srcs: ["dma_buf_heaps/aml_dma_buf_heaps.cpp"],
        }
    },
    static_libs: [
        "libarect",
    ],
    shared_libs: [
        "libhardware",
        "liblog",
        "libcutils",
        "libion",
        "libsync",
        "libutils",
        "libnativewindow",
    ],
    header_libs: [
        "libnativebase_headers",
    ],
}

cc_defaults {
    name: "libgralloc_allocator_dependencies",
    shared_libs: ["libdmabufheap"],
}

cc_library_static {
    name: "libgralloc_allocator",
    defaults: [
        "arm_gralloc_allocator_defaults",
        "arm_gralloc_version_defaults",
        "libgralloc_allocator_dependencies",
    ],
    cflags: [
        "-DGRALLOC_AML_EXTEND=1",
        "-DHEAP_SECURE_DONOT_FALLBACK=0",
    ],
    include_dirs: [
        "hardware/amlogic/gralloc/amlogic",
    ],
}
