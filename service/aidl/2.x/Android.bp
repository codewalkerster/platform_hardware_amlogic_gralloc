package {
    default_applicable_licenses: ["hardware_amlogic_license"],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service",
    proprietary: true,
    relative_install_path: "hw",
    defaults: [
        "arm_gralloc_defaults",
        "arm_gralloc_version_defaults"
    ],
    srcs: [
        ":arm_gralloc_allocator_aidl_service_srcs",
    ],
    init_rc: [
        "android.hardware.graphics.allocator-V2-service.rc",
    ],
    vintf_fragments: ["manifest_allocator.xml"],
    shared_libs: [
        "liblog",
        "libutils",
        "libbinder_ndk",
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.allocator-V2-arm",
    ],
}
